#!/usr/bin/env bash
# ==============================================================================
# BrewPOS — Automated Restoration Verification Script (Bash)
# Course: COMP 018 — Database Administration (Activity 6)
# ==============================================================================
set -euo pipefail

ENV_FILE="${1:-../configuration/.env}"
SQL_FILE="${2:-../sql/verification-queries.sql}"
HOST="${DB_HOST:-localhost}"
PORT="${DB_PORT:-5432}"
TEST_DB="${RESTORE_TEST_DB:-grp_brewposdb_restore_test}"
USERNAME="${DB_SUPERUSER:-postgres}"

if [[ -f "$ENV_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$ENV_FILE"
    set +a
    HOST="${DB_HOST:-$HOST}"
    PORT="${DB_PORT:-$PORT}"
    TEST_DB="${RESTORE_TEST_DB:-$TEST_DB}"
    USERNAME="${DB_SUPERUSER:-$USERNAME}"
    export PGPASSWORD="${DB_PASSWORD:-${PGPASSWORD:-}}"
fi

if [[ -z "${PGPASSWORD:-}" ]]; then
    read -rsp "Enter password for PostgreSQL user '$USERNAME': " PGPASSWORD
    echo
    export PGPASSWORD
fi

echo "[INFO] Running verification queries on $TEST_DB..."
psql -U "$USERNAME" -h "$HOST" -p "$PORT" -d "$TEST_DB" -f "$SQL_FILE"
echo "[SUCCESS] Verification queries finished."

