#!/usr/bin/env bash
# ==============================================================================
# BrewPOS — Create Disposable Restoration Test Database (Bash)
# Course: COMP 018 — Database Administration (Activity 6)
# Safety Rule: NEVER restore over or drop the original 'grp_brewposdb'!
# ==============================================================================
set -euo pipefail

ENV_FILE="${1:-../configuration/.env}"
HOST="${DB_HOST:-localhost}"
PORT="${DB_PORT:-5432}"
ORIGINAL_DB="${DB_NAME:-grp_brewposdb}"
TEST_DB="${RESTORE_TEST_DB:-grp_brewposdb_restore_test}"
USERNAME="${DB_SUPERUSER:-postgres}"

if [[ -f "$ENV_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$ENV_FILE"
    set +a
    HOST="${DB_HOST:-$HOST}"
    PORT="${DB_PORT:-$PORT}"
    ORIGINAL_DB="${DB_NAME:-$ORIGINAL_DB}"
    TEST_DB="${RESTORE_TEST_DB:-$TEST_DB}"
    USERNAME="${DB_SUPERUSER:-$USERNAME}"
    export PGPASSWORD="${DB_PASSWORD:-${PGPASSWORD:-}}"
fi

# Strict check
if [[ "$TEST_DB" == "$ORIGINAL_DB" ]]; then
    echo "[CRITICAL SAFETY ERROR] Target test database cannot match original database ($ORIGINAL_DB)." >&2
    exit 1
fi

if [[ -z "${PGPASSWORD:-}" ]]; then
    read -rsp "Enter password for PostgreSQL user '$USERNAME': " PGPASSWORD
    echo
    export PGPASSWORD
fi

echo "[INFO] Target Test DB: $TEST_DB"
dropdb --if-exists -U "$USERNAME" -h "$HOST" -p "$PORT" "$TEST_DB"
createdb -U "$USERNAME" -h "$HOST" -p "$PORT" -E UTF8 "$TEST_DB"
echo "[SUCCESS] Created clean test database: $TEST_DB"

